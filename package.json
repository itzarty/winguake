{
  "name": "winguake",
  "version": "1.4.0",
  "description": "Guake-inspired terminal emulator using Electron.js",
  "license": "ISC",
  "author": "Arty <arty@itzarty.eu> (https://www.itzarty.eu)",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "auto-launch": "^5.0.6",
    "font-list": "^2.0.1",
    "node-pty": "^1.1.0",
    "node-window-manager": "^2.2.4",
    "plist": "^3.1.0",
    "ps-tree": "^1.2.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "telnet-client": "^2.2.9",
    "uiohook-napi": "^1.5.4",
    "xterm-addon-ligatures": "^0.7.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "node-gyp": "^12.1.0"
  },
  "build": {
    "appId": "me.itzarty.winguake",
    "productName": "WinGuake",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "TerminalEmulator",
      "executableName": "winguake"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!dev/**",
      "!README.md",
      "!.git/**",
      "!package-lock.json"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "./installer.nsh",
      "warningsAsErrors": false
    }
  }
}
