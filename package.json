{
  "name": "winguake",
  "version": "1.2.1",
  "description": "Guake-inspired terminal emulator using Electron.js",
  "license": "ISC",
  "author": "Arty",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder --win --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "auto-launch": "^5.0.6",
    "font-list": "^2.0.1",
    "node-pty": "^1.1.0",
    "uiohook-napi": "^1.5.4",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "node-gyp": "^12.1.0"
  },
  "build": {
    "appId": "me.itzarty.winguake",
    "productName": "WinGuake",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!README.md",
      "!.git/**",
      "!package-lock.json"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "./installer.nsh",
      "warningsAsErrors": false
    }
  }
}
